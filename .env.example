# Copy to .env (gitignored) and fill in only the adapters you use.
# The keyless commands (make test, make demo, oracle and naive models) need none of these.
ANTHROPIC_API_KEY=
# Optional: model id for the anthropic: adapter (default is set in src/babel_bench/models.py)
BABEL_ANTHROPIC_MODEL=
# Optional: bearer token for openai:<url>|<model> endpoints that need one
OPENAI_API_KEY=
